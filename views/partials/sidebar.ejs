<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    .sidebar {
      width: 260px;
      min-width: 260px;
      height: 100vh;
      background: #f7f7f5;
      border-right: 1px solid #e0e0e0;
      display: flex;
      flex-direction: column;
    }

    .sidebar-top {
      padding: 12px;
      border-bottom: 1px solid #e0e0e0;
    }

    .workspace-row {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      color: #1a1a1a;
      cursor: pointer;
      margin-bottom: 8px;
      text-decoration: none;
    }

    .workspace-row:hover {
      background: #ebebeb;
      color: #1a1a1a;
    }

    .ws-icon {
      width: 22px;
      height: 22px;
      background: #9b59b6;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }

    .sidebar-search {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      background: white;
      border: 1px solid #e0e0e0;
      border-radius: 6px;
      font-size: 12px;
      color: #aaa;
      cursor: pointer;
    }

    .sidebar-body {
      flex: 1;
      overflow-y: auto;
      padding: 8px;
    }

    .btn-new-page {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 7px 10px;
      background: transparent;
      border: 1px dashed #ccc;
      border-radius: 6px;
      font-size: 12.5px;
      color: #555;
      text-decoration: none;
      margin-bottom: 10px;
      transition: all 0.15s;
    }

    .btn-new-page:hover {
      background: #ebebeb;
      color: #1a1a1a;
      border-color: #bbb;
    }

    .section-label {
      font-size: 10px;
      font-weight: 600;
      color: #aaa;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 8px 8px 4px;
      margin: 0;
    }

    .page-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12.5px;
      color: #555;
      text-decoration: none;
      margin-bottom: 2px;
      transition: all 0.15s;
    }

    .page-item:hover {
      background: #ebebeb;
      color: #1a1a1a;
    }

    .page-item.active {
      background: white;
      color: #1a1a1a;
      font-weight: 500;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07);
    }

    .no-docs-text {
      font-size: 11px;
      color: #bbb;
      padding: 4px 10px;
    }

    .sidebar-footer {
      padding: 12px;
      border-top: 1px solid #e0e0e0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #764ba2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 600;
      color: white;
      flex-shrink: 0;
    }

    .user-name {
      font-size: 12px;
      font-weight: 500;
      color: #1a1a1a;
      margin: 0;
    }

    .user-email {
      font-size: 10px;
      color: #aaa;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .logout-btn {
      margin-left: auto;
      color: #aaa;
      font-size: 17px;
      text-decoration: none;
      transition: color 0.15s;
    }

    .logout-btn:hover {
      color: #e74c3c;
    }

    /* 200–300px */
    @media (max-width: 300px) {
      .sidebar {
        width: 200px;
        min-width: 200px;
        position: fixed;
        left: 0;
        top: 0;
        height: 100vh;
        z-index: 999;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
        box-shadow: 3px 0 12px rgba(0, 0, 0, 0.1);
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .sidebar-top {
        padding: 8px;
      }

      .workspace-row {
        font-size: 11px;
        padding: 4px 6px;
        margin-bottom: 6px;
        gap: 6px;
      }

      .ws-icon {
        width: 18px;
        height: 18px;
        font-size: 10px;
        border-radius: 4px;
      }

      .sidebar-search {
        font-size: 10px;
        padding: 4px 8px;
        gap: 5px;
      }

      .sidebar-body {
        padding: 6px;
      }

      .btn-new-page {
        font-size: 10px;
        padding: 5px 8px;
        gap: 5px;
        margin-bottom: 7px;
      }

      .section-label {
        font-size: 9px;
        padding: 5px 6px 3px;
        letter-spacing: 0.4px;
      }

      .page-item {
        font-size: 10px;
        padding: 4px 8px;
        gap: 5px;
        margin-bottom: 1px;
      }

      .no-docs-text {
        font-size: 10px;
        padding: 3px 8px;
      }

      .sidebar-footer {
        padding: 8px;
        gap: 6px;
      }

      .user-avatar {
        width: 24px;
        height: 24px;
        font-size: 10px;
      }

      .user-name {
        font-size: 10px;
      }

      .user-email {
        font-size: 9px;
      }

      .logout-btn {
        font-size: 14px;
      }
    }

    .page-item-wrapper {
      position: relative;
      display: flex;
      align-items: center;
      border-radius: 6px;
      margin-bottom: 2px;
    }

    .page-item-wrapper:hover .page-menu-btn {
      opacity: 1;
    }

    .page-item {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 12.5px;
      color: #555;
      text-decoration: none;
      transition: all 0.15s;
      min-width: 0;
    }

    .page-item-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .page-menu-btn {
      opacity: 0;
      background: none;
      border: none;
      cursor: pointer;
      color: #888;
      padding: 4px 6px;
      border-radius: 4px;
      font-size: 14px;
      flex-shrink: 0;
      transition: opacity 0.15s, background 0.15s;
      line-height: 1;
    }

    .page-menu-btn:hover {
      background: #ddd;
      color: #1a1a1a;
    }

    .page-menu-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .page-dropdown {
      display: none;
      position: absolute;
      right: 0;
      top: 110%;
      background: white;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
      z-index: 1000;
      min-width: 130px;
      padding: 4px;
    }

    .page-dropdown.open {
      display: block;
    }

    .dropdown-delete-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 7px 10px;
      background: none;
      border: none;
      border-radius: 6px;
      font-size: 12.5px;
      color: #e74c3c;
      cursor: pointer;
      text-align: left;
      transition: background 0.15s;
    }

    .dropdown-delete-btn:hover {
      background: #fff0f0;
    }
  </style>
</head>

<body>
  <div class="sidebar" id="sidebar">

    <div class="sidebar-top">
      <a href="/dashboard" class="workspace-row">
        <div class="ws-icon">M</div>
        <span>My Workspace</span>
        <i class="bi bi-chevron-down ms-auto" style="font-size: 11px;"></i>
      </a>

    </div>

    <div class="sidebar-body">

      <!-- New Page -->
      <form action="/document/create" method="POST" style="display: inline;">
        <button type="submit" class="btn-new-page" style="cursor: pointer;">
          <i class="bi bi-plus-lg"></i> New page
        </button>
      </form>

      <!-- Pages -->
      <p class="section-label mt-2">Pages</p>
      <% if (locals.docs && docs.length> 0) { %>
        <% docs.forEach(doc=> { %>

          <div class="page-item-wrapper">
            <a href="/document/<%= doc._id %>"
              class="page-item <%= locals.activeDoc && activeDoc == doc._id.toString() ? 'active' : '' %>">
              <span>📄</span>
              <span class="page-item-title">
                <%= doc.title || 'Untitled' %>
              </span>
            </a>

            <div class="page-menu-wrapper">
              <button class="page-menu-btn" onclick="toggleMenu(event, 'menu-<%= doc._id %>')">
                <i class="bi bi-three-dots"></i>
              </button>
              <div class="page-dropdown" id="menu-<%= doc._id %>">
                <form action="/document/<%= doc._id %>/trash?_method=DELETE" method="POST">
                  <button type="submit" class="dropdown-delete-btn">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </div>
            </div>
          </div>

          <% }) %>
            <% } else { %>
              <p class="no-docs-text">No pages yet</p>
              <% } %>
    </div>

    <!-- User Footer -->
    <div class="sidebar-footer">
      <div class="user-avatar">
        <%= locals.user ? user.userName.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div style="flex:1; min-width:0;">
        <p class="user-name">
          <%= locals.user ? user.userName : 'Guest' %>
        </p>
        <p class="user-email">
          <%= locals.user ? user.email : '' %>
        </p>
      </div>


      <a href="/user/logout" class="logout-btn" title="Logout">
        <i class="bi bi-box-arrow-right"></i>
      </a>
    </div>

  </div>
  <script>
    window.addEventListener('load', () => {
      if (typeof io !== 'undefined') {
        const sidebarSocket = io();
        sidebarSocket.on('title-changed', ({ docId, title }) => {
          const link = document.querySelector(`a[href="/document/${docId}"] .page-item-title`);
          if (link) link.textContent = title || 'Untitled';
        });
      }
    });

    function toggleMenu(e, menuId) {
      e.preventDefault();
      e.stopPropagation();
      document.querySelectorAll('.page-dropdown').forEach(d => {
        if (d.id !== menuId) d.classList.remove('open');
      });
      document.getElementById(menuId).classList.toggle('open');
    }

    document.addEventListener('click', () => {
      document.querySelectorAll('.page-dropdown').forEach(d => d.classList.remove('open'));
    });
  </script>
</body>

</html>