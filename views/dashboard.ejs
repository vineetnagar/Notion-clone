<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }

      .dashboard-container {
        display: flex;
        height: 100vh;
        overflow: hidden;
      }

      /* ===== MAIN ===== */
      .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: white;
      }

      /* ===== EDITOR ===== */
      .editor-area {
        flex: 1;
        overflow-y: auto;
      }

      .cover-image {
        height: 180px;
        background: linear-gradient(120deg, #a1c4fd 0%, #c2e9fb 100%);
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding: 12px 16px;
        cursor: pointer;
      }

      .cover-btn {
        background: rgba(255, 255, 255, 0.75);
        border: none;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        color: #555;
        cursor: pointer;
      }

      .cover-btn:hover {
        background: rgba(255, 255, 255, 0.95);
      }

      .editor-content {
        padding: 36px 52px;
        max-width: 860px;
      }

      .page-emoji {
        font-size: 50px;
        line-height: 1;
        margin-bottom: 14px;
        cursor: pointer;
      }

      .page-title {
        font-size: 34px;
        font-weight: 700;
        color: #1a1a1a;
        border: none;
        outline: none;
        background: transparent;
        width: 100%;
        font-family: inherit;
        margin-bottom: 28px;
      }

      .page-title::placeholder {
        color: #ddd;
      }

      .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px 0;
        color: #bbb;
        gap: 12px;
        text-align: center;
      }

      .empty-state i {
        font-size: 44px;
      }
      .empty-state h5 {
        font-size: 15px;
        font-weight: 500;
        color: #999;
        margin: 0;
      }
      .empty-state p {
        font-size: 13px;
        color: #bbb;
        margin: 0;
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 768px) {
        .sidebar {
          position: fixed;
          left: 0;
          top: 0;
          z-index: 999;
          transform: translateX(-100%);
          box-shadow: 4px 0 20px rgba(0, 0, 0, 0.12);
          transition: transform 0.3s;
        }
        .sidebar.open {
          transform: translateX(0);
        }
        .editor-content {
          padding: 24px 20px;
        }
        .page-title {
          font-size: 26px;
        }
      }
      /* 200–300px */
      @media (max-width: 300px) {
        .dashboard-container {
          flex-direction: column;
          height: auto;
          overflow: visible;
        }

        .main-area {
          height: 100vh;
          overflow: hidden;
        }

        .cover-image {
          height: 80px;
          padding: 6px 8px;
        }

        .cover-btn {
          font-size: 9px;
          padding: 3px 7px;
        }

        .editor-content {
          padding: 12px 10px;
          max-width: 100%;
        }

        .page-emoji {
          font-size: 26px;
          margin-bottom: 8px;
        }

        .page-title {
          font-size: 16px;
          margin-bottom: 14px;
        }

        .empty-state {
          padding: 28px 0;
          gap: 7px;
        }

        .empty-state i {
          font-size: 28px;
        }

        .empty-state h5 {
          font-size: 11px;
        }

        .empty-state p {
          font-size: 10px;
        }

        .modal-dialog {
          margin: 8px;
        }

        .modal-title {
          font-size: 12px !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="dashboard-container">
      <!-- ========== SIDEBAR ========== -->
      <%- include("./partials/sidebar") %>

      <!-- ========== MAIN AREA ========== -->
      <div class="main-area">
        <!-- TOPBAR -->
        <%- include("./partials/topbar") %>

        <!-- EDITOR -->
        <div class="editor-area">
          <div class="cover-image">
            <button class="cover-btn">📷 Change cover</button>
          </div>

          <div class="editor-content">
            <div class="page-emoji">📝</div>
            <input
              type="text"
              class="page-title"
              placeholder="Untitled"
              value="Getting started"
            />
            <div class="empty-state">
              <i class="bi bi-file-earmark-plus"></i>
              <h5>Select or create a page</h5>
              <p>
                Click <strong>+ New page</strong> in the sidebar to get started
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SHARE MODAL -->
    <div class="modal fade" id="shareModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-1">
          <div class="modal-header border-0">
            <h5 class="modal-title" style="font-size: 15px; font-weight: 600">
              Share this page
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <label class="form-label" style="font-size: 13px; font-weight: 500"
              >Invite by email</label
            >
            <div class="input-group">
              <input
                type="email"
                class="form-control"
                placeholder="colleague@email.com"
              />
              <button class="btn btn-dark" type="button">Invite</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
