<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"/>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

      .dashboard-container { display: flex; height: 100vh; overflow: hidden; }

      /* ===== MAIN ===== */
      .main-area { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: white; position: relative; }

      /* ===== EDITOR ===== */
      .editor-area { flex: 1; overflow-y: auto; }

      .cover-image { height: 180px; background: linear-gradient(120deg, #f093fb 0%, #f5576c 100%); display: flex; align-items: flex-end; justify-content: flex-end; padding: 12px 16px; gap: 8px; cursor: pointer; position: relative; }
      .cover-image.no-cover { height: 60px; background: transparent; border-bottom: none; justify-content: flex-start; align-items: center; padding: 0 52px; }
      .cover-btn { background: rgba(255,255,255,0.8); border: none; padding: 5px 12px; border-radius: 6px; font-size: 11px; color: #333; cursor: pointer; font-weight: 500; transition: all 0.15s; }
      .cover-btn:hover { background: rgba(255,255,255,1); }
      .add-cover-btn { font-size: 12px; color: #bbb; background: none; border: none; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 4px 0; }
      .add-cover-btn:hover { color: #888; }

      .editor-content { padding: 28px 52px 80px; max-width: 860px; }
      .page-emoji { font-size: 52px; line-height: 1; margin-bottom: 12px; cursor: pointer; display: inline-block; }
      .page-emoji:hover { opacity: 0.8; }
      .page-title { font-size: 36px; font-weight: 700; color: #1a1a1a; border: none; outline: none; background: transparent; width: 100%; font-family: inherit; margin-bottom: 4px; letter-spacing: -0.5px; resize: none; overflow: hidden; line-height: 1.2; }
      .page-title::placeholder { color: #ddd; }
      .divider { height: 1px; background: #f0f0f0; margin: 16px 0; }
      .page-content { width: 100%; min-height: 400px; border: none; outline: none; background: transparent; font-size: 15px; color: #374151; line-height: 1.8; resize: none; font-family: inherit; }
      .page-content::placeholder { color: #ccc; }

      /* ===== FLOATING SAVE BUTTON ===== */
      .save-form {
        position: fixed;
        bottom: 28px;
        right: 32px;
        z-index: 100;
        margin: 0;
        padding: 0;
      }

      .save-form button[type="submit"] {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 11px 22px;
        background: #1a1a1a;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        font-family: inherit;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.22);
        transition: all 0.18s ease;
      }

      .save-form button[type="submit"]:hover {
        background: #333;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
      }

      .save-form button[type="submit"]:active {
        transform: translateY(0px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
      }

      /* ===== RESPONSIVE ===== */
      @media (max-width: 768px) {
        .sidebar { position: fixed; left: 0; top: 0; z-index: 999; transform: translateX(-100%); box-shadow: 4px 0 20px rgba(0,0,0,0.12); transition: transform 0.3s; }
        .sidebar.open { transform: translateX(0); }
        .editor-content { padding: 24px 20px 60px; }
        .page-title { font-size: 26px; }
        .save-form { bottom: 20px; right: 20px; }
      }
    </style>
  </head>
  <body>

    <div class="dashboard-container">

      <!-- ========== SIDEBAR ========== -->
     <%- include("./partials/sidebar") %>

      <!-- ========== MAIN AREA ========== -->
      <div class="main-area">

        <!-- TOPBAR -->
        <%- include("./partials/topbar") %>

        <!-- EDITOR -->
        <div class="editor-area">

          <!-- Cover Image -->
          <% if (doc.coverImage) { %>
            <div class="cover-image" style="background-image: url('<%= doc.coverImage %>'); background-size: cover; background-position: center;">
          
              <!-- Remove cover button -->
              <form action="/document/<%= doc._id %>/cover/remove" method="POST" style="display:inline;">
                <button class="cover-btn" type="submit">🗑️ Remove</button>
              </form>
          
              <!-- Change cover — hidden file input trick -->
              <form action="/document/<%= doc._id %>/cover?_method=PATCH" method="POST" enctype="multipart/form-data" id="changeCoverForm">
                <input type="file" name="coverImage" id="changeCoverInput" accept="image/*" style="display:none;"
                  onchange="document.getElementById('changeCoverForm').submit()"/>
                <button class="cover-btn" type="button" onclick="document.getElementById('changeCoverInput').click()">
                  📷 Change cover
                </button>
              </form>
          
            </div>
          
          <% } else { %>
          
            <div class="cover-image no-cover">
              <!-- Add cover — same hidden file input trick -->
              <form action="/document/<%= doc._id %>/cover?_method=PATCH" method="POST" enctype="multipart/form-data" id="addCoverForm">
                <input type="file" name="coverImage" id="addCoverInput" accept="image/*" style="display:none;"
                  onchange="document.getElementById('addCoverForm').submit()"/>
                <button class="add-cover-btn" type="button" onclick="document.getElementById('addCoverInput').click()">
                  <i class="bi bi-image"></i> Add cover
                </button>
              </form>
            </div>
          
          <% } %>

          <div class="editor-content">

            <!-- Emoji Icon -->
            <div class="page-emoji" title="Click to change icon">
              <%= doc.icon || '📄' %>
            </div>

            <!-- Page Title -->
            <textarea
              class="page-title"
              id="docTitle"
              placeholder="Untitled"
              rows="1"
            ><%= doc.title || '' %></textarea>

            <div class="divider"></div>

            <!-- Page Content -->
            <textarea
              class="page-content"
              id="docContent"
              placeholder=" start writing..."
            ><%= doc.content || '' %></textarea>

          </div>
        </div>

        <!-- ✅ FLOATING SAVE BUTTON — bottom right corner, fixed position -->
        <form
          class="save-form"
          action="/document/<%= doc._id %>"
          method=PATCH
          method="POST"
          id="saveForm"
        >
          <!-- Hidden inputs — JS inhe live update karta hai jab user type kare -->
          <input type="hidden" name="title"   id="formTitle"   value="<%= doc.title || '' %>"/>
          <input type="hidden" name="content" id="formContent" value="<%= doc.content || '' %>"/>
          <button type="submit">
            <i class="bi bi-floppy"></i> Save
          </button>
        </form>

      </div> <!-- main-area end -->
    </div> <!-- dashboard-container end -->

    <!-- SHARE MODAL -->
    <div class="modal fade" id="shareModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-1">
          <div class="modal-header border-0">
            <h5 class="modal-title" style="font-size:15px; font-weight:600;">Share this page</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <label class="form-label" style="font-size:13px; font-weight:500;">Invite by email</label>
            <div class="input-group">
              <input type="email" class="form-control" placeholder="colleague@email.com"/>
              <button class="btn btn-dark" type="button">Invite</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const docId = "<%= doc._id %>";
  let timer;

  function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = el.scrollHeight + 'px';
  }

  document.getElementById('docTitle').addEventListener('input', function() {
    autoResize(this);
    document.getElementById('formTitle').value = this.value;
    document.getElementById('breadcrumbTitle').textContent = this.value || 'Untitled';
    socket.emit('title-update', { docId: docId, title: this.value || 'Untitled' });
    triggerSave();
  });

  document.getElementById('docContent').addEventListener('input', function() {
    document.getElementById('formContent').value = this.value;
    triggerSave();
  });

  autoResize(document.getElementById('docTitle'));

  function triggerSave() {
    clearTimeout(timer);
    timer = setTimeout(() => saveDocument(), 800);
  }

  async function saveDocument() {
    const title   = document.getElementById('docTitle').value;
    const content = document.getElementById('docContent').value;
    try {
      await fetch(`/document/${docId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, content }),
      });
    } catch (err) {
      console.error('Save failed:', err);
    }
  }
</script>
  </body>
</html>
